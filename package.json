{
  "name": "@newrelic/video-hls",
  "version": "2.1.0",
  "description": "New relic tracker for hls player",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./browser": {
      "import": "./dist/esm/browser/index.js",
      "require": "./dist/cjs/browser/index.js"
    },
    "./vega": {
      "import": "./dist/esm/vega/index.js",
      "require": "./dist/cjs/vega/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack  --progress --color --watch",
    "watch:dev": "webpack --progress --color --watch --mode development",
    "prezip": "npm run build",
    "zip": "zip -P newrelic -x '*.DS_Store' -r hls.zip dist samples README.md CHANGELOG.md EULA.md",
    "clean": "rm -rf dist *.zip",
    "third-party-updates": "oss third-party manifest --includeOptDeps && oss third-party notices --includeOptDeps && git add THIRD_PARTY_NOTICES.md third_party_manifest.json",
    "test": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/newrelic/video-hls-js"
  },
  "author": "Peter Addo",
  "license": "Apache-2.0",
  "peerDependencies": {
    "hls.js": ">=1.0.0"
  },
  "dependencies": {
    "@newrelic/video-core": "5.1.1",
    "terser-webpack-plugin": "5.6.1"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/node": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/register": "7.29.7",
    "@newrelic/newrelic-oss-cli": "0.1.2",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "12.0.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "10.3.5",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "13.0.0",
    "babel-jest": "29.7.0",
    "babel-loader": "9.2.1",
    "conventional-changelog-conventionalcommits": "7.0.2",
    "hls.js": "1.7.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "semantic-release": "25.0.9",
    "webpack": "5.111.1",
    "webpack-cli": "4.10.0",
    "webpack-obfuscator": "3.6.1"
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src",
    "browser.js",
    "vega.js",
    "CHANGELOG.md",
    "README.md",
    "!test",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
